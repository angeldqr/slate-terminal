{
  "name": "slate",
  "version": "0.1.0",
  "description": "Terminal para agentes de IA",
  "main": "./out/main/index.js",
  "author": "Ángel Quintero",
  "homepage": "https://github.com/angeldqr/slate-terminal",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/conpty-dll.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/status.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/mirror.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/layout.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/keys.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/titles.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/git.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/processes.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/changes.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/vscodeTheme.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/shortcuts.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/settings.check.mts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/renderer/src/lib.check.mts",
    "look": "electron-vite build && node scripts/look.mjs",
    "look:exe": "node scripts/look.mjs --exe dist/win-unpacked/slate.exe",
    "look:scroll": "node scripts/look-scroll.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.7.0-beta.4",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "blendy": "^0.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "motion": "^14.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.38.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "productName": "Slate",
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true
  }
}
